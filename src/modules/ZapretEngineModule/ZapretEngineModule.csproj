<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZapretEngineModule</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FrameworkSDK\FrameworkSDK.csproj" />
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageModule" AfterTargets="Build">
    <ItemGroup>
      <StageFiles Include="$(TargetDir)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(StageFiles)" DestinationFolder="$(MSBuildProjectDirectory)" SkipUnchangedFiles="true" />
  </Target>

</Project>
