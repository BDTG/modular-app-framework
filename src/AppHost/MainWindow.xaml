<Window x:Class="AppHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modular Framework — AppHost" Height="640" Width="900"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar + Dashboard stats -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Text="" Foreground="#A6E3A1" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Modules root: " Foreground="#CDD6F4" VerticalAlignment="Center"/>
                <TextBox x:Name="ModulesRootBox" Width="420" Foreground="#CDD6F4" Background="#313244"
                         Text="C:\Users\BDTG\Projects\modular-app-framework\src\modules"/>
                <Button x:Name="RefreshBtn" Content="⟳ Quét lại" Click="Refresh_Click" Margin="8,0,0,0" Padding="10,4"/>
                <Button x:Name="StartAllBtn" Content="▶ Start tất cả" Click="StartAll_Click" Margin="8,0,0,0" Padding="10,4"/>
                <Button x:Name="StopAllBtn" Content="■ Stop tất cả" Click="StopAll_Click" Margin="8,0,0,0" Padding="10,4"/>
            </StackPanel>
        </DockPanel>

        <!-- Module list -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ModuleGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" Background="#181825" Foreground="#CDD6F4"
                      RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      SelectionChanged="ModuleGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Manifest.Id}" Width="90"/>
                    <DataGridTextColumn Header="Tên" Binding="{Binding Manifest.DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding State}" Width="110"/>
                    <DataGridTextColumn Header="Restart" Binding="{Binding RestartCount}" Width="60"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Process.Id}" Width="60"/>
                    <DataGridTemplateColumn Header="Hành động" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶" Width="34" Padding="0" Margin="0,0,4,0" ToolTip="Start module"
                                            Click="ModuleStart_Click" Background="#313244" Foreground="#A6E3A1" BorderThickness="0"/>
                                    <Button Content="■" Width="34" Padding="0" ToolTip="Stop module"
                                            Click="ModuleStop_Click" Background="#313244" Foreground="#F38BA8" BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Log viewer -->
            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PauseLogBtn" Content="⏸ Pause" Click="PauseLog_Click" Padding="8,2" Margin="4,0,0,0" FontSize="11"/>
                        <Button x:Name="ClearLogBtn" Content="🗑 Clear" Click="ClearLog_Click" Padding="8,2" Margin="4,0,0,0" FontSize="11"/>
                    </StackPanel>
                    <TextBlock x:Name="LogTitle" Text="Log (chọn module)" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         Background="#11111B" Foreground="#CDD6F4" VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </DockPanel>
        </Grid>

        <!-- Demo ops cho module crashy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Demo cách ly (crashy): " Foreground="#CDD6F4" VerticalAlignment="Center"/>
            <Button x:Name="BoomBtn" Content="💥 boom (exception)" Click="Boom_Click" Padding="10,4" Margin="4,0"/>
            <Button x:Name="ExitBtn" Content="🚪 exit (Environment.Exit)" Click="Exit_Click" Padding="10,4" Margin="4,0"/>
            <Button x:Name="HangBtn" Content="💤 hang (30s)" Click="Hang_Click" Padding="10,4" Margin="4,0"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="#F9E2AF" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- 🛡️ Chống DPI 2 lớp: zapret-engine (lớp 1) + proxy-client sing-box (lớp 2) -->
        <Border Grid.Row="3" Background="#181825" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="🛡️ Node proxy:" Foreground="#89B4FA" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="NodeTypeBox" Width="120" Foreground="#CDD6F4" Background="#313244" SelectedIndex="0">
                        <ComboBoxItem Content="VLESS-REALITY"/>
                        <ComboBoxItem Content="Hysteria2"/>
                    </ComboBox>
                    <TextBlock Text="Server:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="NodeServerBox" Width="150" Foreground="#CDD6F4" Background="#313244"/>
                    <TextBlock Text="Port:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="NodePortBox" Width="55" Foreground="#CDD6F4" Background="#313244" Text="443"/>
                    <TextBlock Text="UUID/Pass:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="NodeSecretBox" Width="200" Foreground="#CDD6F4" Background="#313244"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="SNI:" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    <TextBox x:Name="NodeSniBox" Width="160" Foreground="#CDD6F4" Background="#313244" Margin="4,0,0,0"/>
                    <TextBlock Text="PubKey(Reality):" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="NodeKeyBox" Width="220" Foreground="#CDD6F4" Background="#313244"/>
                    <TextBlock Text="ShortID:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="NodeShortIdBox" Width="80" Foreground="#CDD6F4" Background="#313244"/>
                    <Button x:Name="SaveNodeBtn" Content="💾 Lưu node" Click="SaveNode_Click" Padding="10,4" Margin="8,0,0,0"/>
                    <Button x:Name="TwoLayerOnBtn" Content="🚀 Bật 2 lớp" Click="TwoLayerOn_Click" Padding="10,4" Margin="8,0,0,0"/>
                    <Button x:Name="TwoLayerOffBtn" Content="⏹ Tắt 2 lớp" Click="TwoLayerOff_Click" Padding="10,4" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
