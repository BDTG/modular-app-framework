<Window x:Class="AppHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modular Framework — AppHost" Height="680" Width="1020" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen" Background="#0F1011"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#D0D6E0">
    <Window.Resources>
        <!-- ── Linear tokens ─────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgPanel" Color="#0F1011"/>
        <SolidColorBrush x:Key="BgSurface" Color="#191A1B"/>
        <SolidColorBrush x:Key="BgHover" Color="#28282C"/>
        <SolidColorBrush x:Key="BgInset" Color="#111214"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7F8F8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#D0D6E0"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#8A8F98"/>
        <SolidColorBrush x:Key="TextQuaternary" Color="#62666D"/>
        <SolidColorBrush x:Key="Accent" Color="#5E6AD2"/>
        <SolidColorBrush x:Key="AccentHover" Color="#828FFF"/>
        <SolidColorBrush x:Key="Success" Color="#10B981"/>
        <SolidColorBrush x:Key="Danger" Color="#F85149"/>
        <SolidColorBrush x:Key="Warn" Color="#D29922"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#23232328"/>   <!-- white 0.05 -->
        <SolidColorBrush x:Key="BorderStd" Color="#32232328"/>      <!-- white 0.08 -->
        <SolidColorBrush x:Key="BorderSolid" Color="#23252A"/>

        <!-- ── Ghost button (default) ────────────────────────────── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0D6E0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSolid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28282C"/>
                                <Setter Property="Foreground" Value="#F7F8F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#32323238"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button (accent) ───────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#5E6AD2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#5E6AD2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7170FF"/>
                    <Setter Property="BorderBrush" Value="#7170FF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Danger button ─────────────────────────────────────── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="#F85149"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8514914"/>
                    <Setter Property="Foreground" Value="#F85149"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TextBox ───────────────────────────────────────────── -->
        <Style x:Key="MfInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSolid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentHover}"/>
            <Setter Property="SelectionBrush" Value="#5E6AD288"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5E6AD2"/>
                                <Setter TargetName="bd" Property="Background" Value="#1B1C1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox ──────────────────────────────────────────── -->
        <Style x:Key="MfCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSolid}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- ── DataGrid ──────────────────────────────────────────── -->
        <Style x:Key="MfGridColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSubtle}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MfGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5E6AD233"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MfGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28282C66"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header: brand + stats pills ───────────────────────── -->
        <DockPanel Grid.Row="0" Margin="2,0,2,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="MODULAR FRAMEWORK" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="AppHost — crash-isolated module runtime" FontSize="11" Foreground="{StaticResource TextQuaternary}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSolid}" BorderThickness="1" CornerRadius="999" Padding="9,3" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource TextTertiary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatTotal" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text=" module" Foreground="{StaticResource TextTertiary}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSolid}" BorderThickness="1" CornerRadius="999" Padding="9,3" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatRunning" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text=" chạy" Foreground="{StaticResource TextTertiary}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSolid}" BorderThickness="1" CornerRadius="999" Padding="9,3" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource TextQuaternary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatStopped" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text=" tắt" Foreground="{StaticResource TextTertiary}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="Transparent" BorderBrush="{StaticResource BorderSolid}" BorderThickness="1" CornerRadius="999" Padding="9,3" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Danger}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatDisabled" Text="0" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text=" disabled" Foreground="{StaticResource TextTertiary}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ── Toolbar ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,2,10">
            <TextBox x:Name="ModulesRootBox" Width="430" Style="{StaticResource MfInput}"
                     Text="C:\Users\BDTG\Projects\mf-all"/>
            <Button x:Name="RefreshBtn" Content="⟳ Quét lại" Style="{StaticResource GhostBtn}" Margin="6,0,0,0"/>
            <Button x:Name="StartAllBtn" Content="▶ Start tất cả" Style="{StaticResource PrimaryBtn}" Margin="6,0,0,0"/>
            <Button x:Name="StopAllBtn" Content="■ Stop tất cả" Style="{StaticResource DangerBtn}" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- ── Content: module grid + log panel ──────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="1">
                <DataGrid x:Name="ModuleGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                          GridLinesVisibility="None" HeadersVisibility="Column" CanUserResizeRows="False"
                          CanUserAddRows="False" BorderThickness="0" RowStyle="{StaticResource MfGridRow}"
                          ColumnHeaderStyle="{StaticResource MfGridColHeader}" CellStyle="{StaticResource MfGridCell}"
                          SelectionChanged="ModuleGrid_SelectionChanged" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Manifest.Id}" Width="95"/>
                        <DataGridTextColumn Header="Module" Binding="{Binding Manifest.DisplayName}" Width="*"/>
                        <DataGridTemplateColumn Header="State" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Restarting">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Disabled">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Restart" Binding="{Binding RestartCount}" Width="56"/>
                        <DataGridTemplateColumn Header="PID" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Process.Id}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="▶" Width="30" Height="22" Padding="0" Margin="0,0,4,0" ToolTip="Start module"
                                                Click="ModuleStart_Click" Background="#1B1C1F" Foreground="#10B981" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                FontSize="10"/>
                                        <Button Content="■" Width="30" Height="22" Padding="0" ToolTip="Stop module"
                                                Click="ModuleStop_Click" Background="#1B1C1F" Foreground="#F85149" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Log panel -->
            <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,8,8,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PauseLogBtn" Content="Pause" Click="PauseLog_Click" Padding="8,3" Margin="4,0,0,0" FontSize="11" Style="{StaticResource GhostBtn}"/>
                            <Button x:Name="ClearLogBtn" Content="Clear" Click="ClearLog_Click" Padding="8,3" Margin="4,0,0,0" FontSize="11" Style="{StaticResource GhostBtn}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LogTitle" Text="Log — chọn một module" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="LogPath" Text="" FontSize="10.5" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextQuaternary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{StaticResource BgInset}" BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}" CornerRadius="0,0,7,7" Margin="1,0,1,1">
                        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                 Background="Transparent" Foreground="#C9CDD6" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" BorderThickness="0" Padding="10,8"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Demo crashy ───────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,10,2,0">
            <TextBlock Text="Isolation demo" FontSize="11" Foreground="{StaticResource TextQuaternary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="BoomBtn" Content="boom (exception)" Click="Boom_Click" Padding="8,4" FontSize="11.5" Style="{StaticResource GhostBtn}"/>
            <Button x:Name="ExitBtn" Content="exit (Environment.Exit)" Click="Exit_Click" Padding="8,4" FontSize="11.5" Style="{StaticResource GhostBtn}" Margin="6,0,0,0"/>
            <Button x:Name="HangBtn" Content="hang (30s)" Click="Hang_Click" Padding="8,4" FontSize="11.5" Style="{StaticResource GhostBtn}" Margin="6,0,0,0"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextTertiary}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- ── 🛡️ 2 lớp chống DPI ────────────────────────────────── -->
        <Border Grid.Row="4" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="2,10,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left" Text="2-LAYER DPI BYPASS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="NodeTypeBox" Width="118" Style="{StaticResource MfCombo}" SelectedIndex="0">
                            <ComboBoxItem Content="VLESS-REALITY"/>
                            <ComboBoxItem Content="Hysteria2"/>
                        </ComboBox>
                        <TextBox x:Name="NodeServerBox" Width="130" Style="{StaticResource MfInput}" Margin="6,0,0,0"/>
                        <TextBox x:Name="NodePortBox" Width="50" Style="{StaticResource MfInput}" Margin="6,0,0,0" Text="443"/>
                        <TextBox x:Name="NodeSecretBox" Width="190" Style="{StaticResource MfInput}" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SaveNodeBtn" Content="Lưu node" Click="SaveNode_Click" Padding="10,4" FontSize="12" Style="{StaticResource GhostBtn}"/>
                        <Button x:Name="TwoLayerOnBtn" Content="▶ Bật 2 lớp" Click="TwoLayerOn_Click" Padding="10,4" FontSize="12" Style="{StaticResource PrimaryBtn}" Margin="6,0,0,0"/>
                        <Button x:Name="TwoLayerOffBtn" Content="■ Tắt 2 lớp" Click="TwoLayerOff_Click" Padding="10,4" FontSize="12" Style="{StaticResource DangerBtn}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NodeSniBox" Width="150" Style="{StaticResource MfInput}"/>
                        <TextBox x:Name="NodeKeyBox" Width="200" Style="{StaticResource MfInput}" Margin="6,0,0,0"/>
                        <TextBox x:Name="NodeShortIdBox" Width="64" Style="{StaticResource MfInput}" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
