<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppHost2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Modular Framework — AppHost">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar (drag region) — đồng màu app -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="36" Background="Transparent">
            <TextBlock Text="Modular Framework — AppHost" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Border>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneTitle="MODULAR FRAMEWORK" OpenPaneLength="248" CompactModeThresholdWidth="700"
                        ItemInvoked="NavView_ItemInvoked" SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="DPI 2 lớp" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Link"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator/>
            <NavigationViewItemHeader Content="MODULES"/>
            <NavigationViewItem Content="Module Manager" Tag="manager">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AllApps"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator/>
            <NavigationViewItem Content="Isolation demo" Tag="demo">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Repair"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Cài đặt" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame"/>
        </NavigationView>
        </Grid>
        </Window>
