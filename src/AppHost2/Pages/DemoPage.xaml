<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppHost2.Pages.DemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Demo cách ly module" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="Module crashy ném exception / thoát / treo — supervisor tự restart, các module khác không bị ảnh hưởng." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button x:Name="BoomBtn" Content="💥 boom (exception)" Click="BoomBtn_Click"/>
            <Button x:Name="ExitBtn" Content="🚪 exit (Environment.Exit)" Click="ExitBtn_Click"/>
            <Button x:Name="HangBtn" Content="💤 hang (30s)" Click="HangBtn_Click"/>
            <TextBlock x:Name="DemoStatus" Text="" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
