<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppHost2.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Chống DPI 2 lớp" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock Text="zapret-engine (packet-level) + proxy-client sing-box (TUN) — chạy elevated để winws2/TUN hoạt động." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="NODE PROXY" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="NodeTypeBox" Width="150" SelectedIndex="0">
                                <ComboBoxItem Content="VLESS-REALITY"/>
                                <ComboBoxItem Content="Hysteria2"/>
                            </ComboBox>
                            <TextBox x:Name="NodeServerBox" PlaceholderText="Server" Width="150"/>
                            <TextBox x:Name="NodePortBox" PlaceholderText="Port" Width="70" Text="443"/>
                            <TextBox x:Name="NodeSecretBox" PlaceholderText="UUID / Password" Width="220"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="NodeSniBox" PlaceholderText="SNI" Width="170"/>
                            <TextBox x:Name="NodeKeyBox" PlaceholderText="PublicKey (Reality)" Width="230"/>
                            <TextBox x:Name="NodeShortIdBox" PlaceholderText="ShortID" Width="90"/>
                            <Button x:Name="SaveNodeBtn" Content="💾 Lưu node" Click="SaveNodeBtn_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="TwoLayerOnBtn" Content="🚀 Bật 2 lớp" Click="TwoLayerOnBtn_Click" Style="{ThemeResource AccentButtonStyle}"/>
                            <Button x:Name="TwoLayerOffBtn" Content="⏹ Tắt 2 lớp" Click="TwoLayerOffBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="HomeStatus" Text="" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefault}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TRAO ĐỔI NHANH" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock Text="Chọn module ở thanh trái → mở từng chức năng trong module (ops) + log realtime." Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Module cao cấp: tweaks (registry + rollback) · blockcheck (quét DPI) · windows-activation (traces/cleanKms) · system-cleanup · startup-manager..." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
