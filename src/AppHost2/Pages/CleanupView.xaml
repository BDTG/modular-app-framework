<?xml version="1.0" encoding="utf-8"?>
<local:ModuleViewBase
    x:Class="AppHost2.Pages.CleanupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AppHost2.Pages"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="System Cleanup" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="StatusText" Text="Quét dung lượng file tạm trên hệ thống — dọn từng loại hoặc tất cả." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="ScanRing" IsActive="False" Width="22" Height="22"/>
            <Button x:Name="ScanBtn" Content="🔍 Quét lại" Click="ScanBtn_Click"/>
            <Button x:Name="CleanAllBtn" Content="🧹 Dọn tất cả" Click="CleanAllBtn_Click" Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="EmptyBinBtn" Content="🗑 Dọn thùng rác" Click="EmptyBinBtn_Click"/>
        </StackPanel>

        <ListView Grid.Row="2" x:Name="TargetsList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,12" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="{Binding Icon}" FontSize="22" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Path}" Opacity="0.5" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                        <Button Grid.Column="3" Content="Dọn" Click="CleanOne_Click" Tag="{Binding TargetName}" Padding="16,6" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:ModuleViewBase>